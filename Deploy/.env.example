# Copy to Deploy/.env on the GPU host. Do not commit the resulting file.
GAME_DOMAIN=cake.example.com
PUBLIC_ORIGIN=https://cake.example.com
ACME_EMAIL=owner@example.com
# TURN_URL is provided to peers; use your relay's reachable public hostname.
TURN_URL=turn:cake.example.com:3478?transport=udp,turn:cake.example.com:3478?transport=tcp
# Generate with: openssl rand -hex 32
TURN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PUBLIC_IP=203.0.113.10
GAME_EXECUTABLE=/opt/pieceofcake/Builds/Linux/Linux/PieceOfCake.sh
